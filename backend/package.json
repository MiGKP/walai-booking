{
  "name": "walai-booking-backend",
  "version": "1.0.0",
  "description": "Walai Floating Resort Booking System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch -r ts-node/register src/index.ts",
    "build": "tsc",
    "test:regression": "npm run build && node --test \"tests/regression/*.test.cjs\"",
    "test:integration": "node --test \"tests/integration/*.test.cjs\"",
    "start": "node dist/index.js",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "seed": "node -r ts-node/register src/db/seed.ts",
    "test:cloudinary": "node --test -r ts-node/register src/services/cloudinary.service.test.ts",
    "test:booking-room-math": "node --test -r ts-node/register src/services/booking-room.math.test.ts",
    "test:booking-boat-math": "node --test -r ts-node/register src/services/booking-boat.math.test.ts",
    "test:google-oauth-profile": "node --test -r ts-node/register src/services/google-oauth.profile.test.ts",
    "test:round-boats": "node --test -r ts-node/register src/services/round-boats.test.ts",
    "test:promotion-apply": "node --test -r ts-node/register src/services/promotion-apply.test.ts"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.5"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
