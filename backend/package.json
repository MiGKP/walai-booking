{
  "name": "walai-booking-backend",
  "version": "1.0.0",
  "description": "Walai Floating Resort Booking System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "seed": "node -r ts-node/register src/db/seed.ts",
    "test:cloudinary": "node --test -r ts-node/register src/services/cloudinary.service.test.ts",
    "test:booking-room-math": "node --test -r ts-node/register src/services/booking-room.math.test.ts",
    "test:booking-boat-math": "node --test -r ts-node/register src/services/booking-boat.math.test.ts",
    "test:google-oauth-profile": "node --test -r ts-node/register src/services/google-oauth.profile.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.3",
    "typescript": "^5.3.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
